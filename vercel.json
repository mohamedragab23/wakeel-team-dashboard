{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/rooster-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/performance-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/daily-backup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rider-metadata-reminder",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/ops-validation",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/rooster-keepalive",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/rooster-live-sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/gmail-oauth-health-check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/forward-okta-otp",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/equipment-auto-deductions",
      "schedule": "15 5 * * *"
    }
  ]
}

